# Names only. Values are shared privately. Never commit .env.
# Never give a secret a NEXT_PUBLIC_ name.

# Chain (BSC testnet)
NEXT_PUBLIC_CHAIN_ID=97
NEXT_PUBLIC_CONTRACT_ADDRESS=
CHAIN_RPC_URL=
CHAIN_RPC_FALLBACK=

# Wallets
AGENT_PRIVATE_KEY=
PLATFORM_WALLET_ADDRESS=
# contracts only, never on Vercel
DEPLOYER_PRIVATE_KEY=

# Fees (wei, measured in task A3)
GAS_PER_RESPONSE_WEI=
MIN_PROFIT_PER_RESPONSE_WEI=
FEE_PER_RESPONSE_WEI=

# Verification
BSCSCAN_API_KEY=

# AI label
GROQ_API_KEY=
GROQ_MODEL=

# Database (Neon)
DATABASE_URL=

# HMAC for email hashes. Generate once: openssl rand -hex 32. Never change it.
HASH_SECRET=

# Auth
REQUIRE_RESEARCHER_AUTH=true
# Better Auth (sign-in with email + wallet). Generate once: openssl rand -hex 32. Never NEXT_PUBLIC_.
BETTER_AUTH_SECRET=
# The public URL of the app (no trailing slash). Must match the address in the browser bar.
# Local dev: http://localhost:3000. On Vercel: leave it unset (the app uses the Vercel production domain,
# or the branch URL on a preview), or set it for Production only when you use a custom domain.
BETTER_AUTH_URL=

# scripts/e2e.ts only
E2E_RESEARCHER_PRIVATE_KEY=
# comma-separated
E2E_RESPONDENT_PRIVATE_KEYS=
