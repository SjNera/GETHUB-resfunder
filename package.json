{
  "name": "resfunder",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint",
    "check": "next typegen && tsc --noEmit && vitest run",
