# Leave empty to run in demo mode (all transactions simulated).
# Set after deploying SurveyEscrow and the mock tPHP token from Remix (see ../contracts/README.md).
NEXT_PUBLIC_ESCROW_ADDRESS=
NEXT_PUBLIC_TOKEN_ADDRESS=

# Optional: comma-separated demo allowlist of school emails (defaults in src/lib/allowlist.ts).
NEXT_PUBLIC_ALLOWLIST=
